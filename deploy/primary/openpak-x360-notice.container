[Unit]
Description=OpenPak Xbox 360 connectivity pages (x360-notice): xncsi and notice.xbox.com

[Container]
ContainerName=openpak-x360-notice
Image=ghcr.io/openpak/x360-notice:latest
AutoUpdate=registry
Network=openpak.network
IP=10.89.2.245
# Traefik routes Host(xncsi.xboxlive.com) and Host(notice.xbox.com) on the plain-HTTP entrypoint to :8080.
Environment=X360_NOTICE_ADDR=:8080

[Service]
Restart=always

[Install]
WantedBy=default.target
