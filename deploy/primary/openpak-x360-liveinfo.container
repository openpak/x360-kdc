[Unit]
Description=OpenPak Xbox 360 LiveHive endpoint (x360-liveinfo): /liveinfo/GetLiveConfig.ashx, Live service 25

[Container]
ContainerName=openpak-x360-liveinfo
Image=ghcr.io/openpak/x360-kdc:latest
Entrypoint=/usr/local/bin/x360-liveinfo
AutoUpdate=registry
Network=openpak.network
IP=10.89.2.251
# Traefik routes PathPrefix(/liveinfo) on the plain-HTTP entrypoint to :10025 (XAM dials a dotted IP, no Host header to match).
Environment=X360_LIVEINFO_ADDR=:10025
Environment=X360_LIVEINFO_DEBUG=true

[Service]
Restart=always

[Install]
WantedBy=default.target
