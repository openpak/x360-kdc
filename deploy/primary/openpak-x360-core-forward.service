[Unit]
Description=OpenPak: forward account core gRPC (ZeroTier 20001 -> loopback 20001) for the secondary x360-kdc
After=network-online.target openpak-account.service

[Service]
ExecStart=/usr/bin/python3 /home/ubuntu/openpak/deploy/x360-core-forward.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
