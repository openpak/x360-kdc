# SECONDARY host (draughts-server). OpenPak Xbox 360 KDC (xemacs/xeas/xetgs.xboxlive.com, UDP 88).
# Rootless podman cannot bind 88 in the host network namespace, so the service listens on 10088 and
# openpak-x360-kdc-fw.service redirects UDP 88 -> 10088 (own nft table, INPUT accept before the REJECT).
# Host networking keeps the console source address. Secrets and state live under ~/openpak/deploy/x360-kdc.
[Unit]
Description=OpenPak Xbox 360 KDC (x360-kdc) on the secondary, UDP 10088 behind the 88 redirect
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=openpak-x360-kdc
Image=ghcr.io/openpak/x360-kdc:latest
AutoUpdate=registry
Network=host
ReadOnly=true
DropCapability=ALL
# The image binary carries cap_net_bind_service (file capability); exec fails with EPERM unless the
# capability is permitted, even though the service listens on 10088 here.
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
UserNS=keep-id:uid=100,gid=101
Volume=%h/openpak/deploy/x360-kdc/secrets:/run/secrets:ro,Z
Volume=%h/openpak/deploy/x360-kdc/state:/var/lib/x360-kdc:rw,Z
EnvironmentFile=%h/openpak/deploy/x360-kdc/core.env
Environment=X360_KDC_ADDR=:10088
Environment=X360_KDC_XMACS_KEY=/run/secrets/xmacs-dev-private.pem
Environment=X360_KDC_CONSOLE_CA=/run/secrets/console-ca-public.pem
Environment=X360_KDC_ACCOUNTS=/var/lib/x360-kdc/accounts.json
Environment=X360_KDC_TICKET_KEY=/var/lib/x360-kdc/ticket-key.bin
Environment=X360_KDC_SG_ADDRESS=143.47.231.210
Environment=X360_KDC_D7_SERVICES=1,20,25,5,11,12,26,21,34,35,33,2,10
# User sign-in (user AS exchange): profile keys and WLID tickets from x360-xuacs on the primary over
# ZeroTier. X360_KDC_XUACS_KEY comes from core.env.
Environment=X360_KDC_XUACS_URL=http://10.212.63.196:20005

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
