# x360-gateway on its own public address (143.47.231.210 -> private 10.0.0.83): UDP 3074 to that address goes to :13075.
# Matches by destination address only, so the original Xbox on the main address (10.0.0.22) is never touched.
# The session's later datagrams follow the conntrack entry, kept for an hour after the last reply.
add table ip x360gw
delete table ip x360gw
table ip x360gw {
  ct timeout x360gw {
    protocol udp
    policy = { unreplied: 600, replied: 3600 }
  }
  chain pre {
    type nat hook prerouting priority dstnat; policy accept;
    ip daddr 10.0.0.83 udp dport 3074 counter ct timeout set "x360gw" redirect to :13075
  }
}
