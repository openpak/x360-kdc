# UDP listen address. The firmware dials xemacs/xeas/xetgs.xboxlive.com on port 88, so keep 88
# on the public side (the three names resolve to this one socket). Port 88 is privileged:
# the container image carries cap_net_bind_service; a bare binary needs root, setcap or a
# high port plus a redirect. For the local Wharf test use 127.0.0.1:18088.
X360_KDC_ADDR=:88

# Required. RSA-2048 private key (PEM) whose public half the console firmware/emulator
# carries as the XMACS key; decrypts the OAEP block of the MACS request.
X360_KDC_XMACS_KEY=/run/secrets/xmacs-private.pem

# Required. RSA-2048 public key (PEM) of the OpenPak console CA: the only trust anchor for
# the 424-byte console certificate. Nothing signed by anyone else is accepted.
X360_KDC_CONSOLE_CA=/run/secrets/console-ca-public.pem

# Machine-account store (JSON, written 0600, atomic rename). Created on first provisioning.
X360_KDC_ACCOUNTS=/var/lib/x360-kdc/accounts.json

# 16-byte ticket key; created 0600 with random bytes when missing. Losing it only invalidates
# tickets in flight (the firmware re-authenticates from MACS).
X360_KDC_TICKET_KEY=/var/lib/x360-kdc/ticket-key.bin

# IPv4 of the security gateway advertised in the TGS reply (D7 record, services 1 and 20).
# 10.0.2.2 is the emulator's address for its host and is right ONLY for a local Wharf test.
X360_KDC_SG_ADDRESS=10.0.2.2

# Optional. Debug-level logging.
# X360_KDC_DEBUG=false

# x360-liveinfo (LiveHive, Live service 25): TCP listen address for /liveinfo/GetLiveConfig.ashx.
# Port 25 is privileged; the image binary carries cap_net_bind_service.
# X360_LIVEINFO_ADDR=:25
# Optional hex SMRevision. OMIT unless needed: when present it must equal the console's local
# revision (public 17559 update: 126d69eb6cf3737c) or XAM asks for a system update.
# X360_LIVEINFO_SMREVISION=
# LiveHivePollFrequencyInMinutes, 30..240.
# X360_LIVEINFO_POLL_MINUTES=120
# X360_LIVEINFO_DEBUG=false
